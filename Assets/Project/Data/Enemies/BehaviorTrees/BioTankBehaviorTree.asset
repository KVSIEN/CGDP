    RefIds:
    - rid: 1000
      type: {class: BtRoot, ns: CGD.BehaviorTrees, asm: CGD.Runtime}
      data:
        _guid: 1ba0f3f01fc94390837d21d85118d87a
        _position: {x: 0, y: 0}
        _comment: 'BIO tank (plague hulk): a slow mass of flesh with a huge health pool that fights at mid range with poison. It holds about 11 m off, strafing and spitting poison bolts that leave a poison pool where they land, lobs Acid Spew pools into the enemy''s path (Grenade), and when something gets within 5 m chokes it in a Plague Cloud (Signature) and strikes with a poisoned blow in reach; below 60% health it regrows (Boost: Regrowth, 15 health a second for 8 s). Immune to poison. Its Soak Aura takes 30% of every hit on an ally within 8 m. Kit: Signature (Plague Cloud), Boost (Regrowth), Grenade (Acid Spew).'
        _children:
        - ac40c7e214cc4e37a5f193faca53f966
