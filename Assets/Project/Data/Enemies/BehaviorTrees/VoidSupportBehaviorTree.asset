    RefIds:
    - rid: 1000
      type: {class: BtRoot, ns: CGD.BehaviorTrees, asm: CGD.Runtime}
      data:
        _guid: e9b60be26b8542d0919a12d5354aec80
        _position: {x: 0, y: 0}
        _comment: 'VOID support agent (warden): wards its coven from far back. In a fight it holds the spot that reaches the most allies with its Void Ward (8 m: +35 shield each), about 6 m behind the ally nearest the threat, in high cover first, and shoots from there. It breaks off to ward whoever is being hit or has lost its shield (Support), lays a Null Field (Signature: no abilities and slowed inside) on its target when it sees it, so whatever presses its allies fights without its tricks, and phases out (Escape: Phase Shift) when something gets within 6 m. Calm, it follows its leader and wards anyone still worn down. Kit: Support (Void Ward), Signature (Null Field), Escape (Phase Shift).'
        _children:
        - 862abb4110b349b8b8b5e7fd538025e1
    - rid: 1001
      type: {class: Selector, ns: CGD.BehaviorTrees, asm: CGD.Runtime}
