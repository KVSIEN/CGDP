    RefIds:
    - rid: 1000
      type: {class: BtRoot, ns: CGD.BehaviorTrees, asm: CGD.Runtime}
      data:
        _guid: ee7696869a6d413ead9ebb2c4d141e61
        _position: {x: 0, y: 0}
        _comment: 'TECH support agent (paladin): a field engineer that tanks for its squad. Heavily plated and shielded, it holds the front of the line about 2 m ahead of the ally nearest the threat, in cover facing it when it knows some, and never falls back: it bashes away anything that rushes it (Special: Weapon Bash), Fortifies when it takes fire (Boost: +60 armour, +30 shield), throws a Barrier Field over two or more allies fighting near it (Signature: +60 armour), and breaks off to restore whoever is losing its shield or plating (Support: Field Restoration, +30 shield and +15 plating each). Calm, it follows its leader and repairs anyone still worn down. Kit: Support (Field Restoration), Signature (Barrier Field), Boost (Fortify), Special (Weapon Bash).'
        _children:
        - 28ed0d32f8844f06a6374e9d976a3cae
