  references:
    version: 2
    RefIds:
    - rid: 1000
      type: {class: BtRoot, ns: CGD.BehaviorTrees, asm: CGD.Runtime}
      data:
        _guid: ee7696869a6d413ead9ebb2c4d141e61
        _position: {x: 0, y: 0}
        _comment: 'TECH support agent (shield wall): a field engineer built round a front-facing barrier. Its Frontal Shield stands a one-way wall in front of it: hostile fire from the front stops on it, while its own and its allies'' shots from behind pass through. It holds the front of the line about 2 m ahead of the ally nearest the threat, facing it, and never falls back while the shield holds: it bashes away anything that rushes it (Special: Weapon Bash) and Fortifies when it takes fire (Boost). To repair it lowers the shield: it pops a Smoke Screen where it stands, then casts Field Restoration (Support: +30 shield and +15 plating to everyone within 8 m, itself included), on itself when worn down or after walking to an ally that is. With the shield broken it smokes and drops back behind its allies until it is up again. Calm, it follows its leader and repairs anyone still worn down. Kit: Support (Field Restoration), Boost (Fortify), Special (Weapon Bash); Smoke Screen (TechSmokeCoverAbility) is set on the tree; the shield is on the prefab (Frontal Shield with a barrier).'
        _children:
        - 41e3d4fde8b74f69babb7b62161be33f
    - rid: 1001
