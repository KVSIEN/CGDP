    RefIds:
    - rid: 1000
      type: {class: BtRoot, ns: CGD.BehaviorTrees, asm: CGD.Runtime}
      data:
        _guid: 1ba0f3f01fc94390837d21d85118d87a
        _position: {x: 0, y: 0}
        _comment: 'BIO support agent (pack mender): engage support that hunts as the pack''s second animal. It runs at the shoulder of the ally leading the hunt (the one nearest the prey), closes in alongside it and joins the kill once the prey is within 5 m, biting whatever is in reach. Between bites it roars the pack on (Signature: Rallying Roar) and mends whoever is being mauled (Support: Mending Spores, 8 m: heals, regrows bone plating, clears burns, bleeds and poison). Within 7 m it also lunges in with a Feeding Bite: it latches onto its target, holding it (the player must tap Interact to shake it off) and draining health into itself. Only when badly hurt and cornered does it vanish (Escape: Ambush) or slip into a bush. Calm, it follows its leader and mends anyone still hurt. Kit: Support (Mending Spores), Signature (Rallying Roar), Escape (Ambush).'
        _children:
        - b79eccccd36842159d0bf949c8ee649d
    - rid: 1001
      type: {class: Selector, ns: CGD.BehaviorTrees, asm: CGD.Runtime}
