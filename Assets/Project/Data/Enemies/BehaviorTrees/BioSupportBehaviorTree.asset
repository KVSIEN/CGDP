    RefIds:
    - rid: 1000
      type: {class: BtRoot, ns: CGD.BehaviorTrees, asm: CGD.Runtime}
      data:
        _guid: 1ba0f3f01fc94390837d21d85118d87a
        _position: {x: 0, y: 0}
        _comment: 'BIO support agent (mender): a pack''s healer that stays just behind the pack. In a fight it holds the spot that reaches the most allies with its Mending Spores (8 m: heals and clears burns, bleeds and poison), about 3 m behind the ally nearest the threat, in cover when it knows some, keeping up as the pack surges forward. It breaks off to mend whoever is being mauled or worn down (Support), roars the pack on (Signature: Rallying Roar) when two or more fight near it, bites anything that reaches it, and when cornered vanishes with its Escape (Ambush) or into a bush. Calm, it follows its leader and mends anyone still hurt. Kit: Support (Mending Spores), Signature (Rallying Roar), Escape (Ambush).'
        _children:
        - 5d09698eddce415ca7a5a6d16158f743
