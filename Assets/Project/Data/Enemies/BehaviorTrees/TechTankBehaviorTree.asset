    RefIds:
    - rid: 1000
      type: {class: BtRoot, ns: CGD.BehaviorTrees, asm: CGD.Runtime}
      data:
        _guid: ee7696869a6d413ead9ebb2c4d141e61
        _position: {x: 0, y: 0}
        _comment: 'TECH tank (siege walker): a slow, heavy machine buried in armour and plating that anchors its squad from long range. It keeps about 30 m from the enemy, walking back from anything closer while facing it, and pins it with suppressing fire (rockets that burst on impact) instead of chasing kills; it fires a Missile Salvo at what it can see up to 50 m (Signature), shells where the enemy was last seen with a Mortar Shell every 6 s from 18 m out, throws its kit grenade at anything within 12 m, Fortifies under fire (Boost) and bashes away anything that reaches it (Special). Its Soak Aura takes 35% of every hit on an ally within 12 m. Low damage, hard to kill. Kit: Signature (Missile Salvo), Boost (Fortify), Special (Weapon Bash), Grenade (Tech Grenade); the Mortar Shell is set on the tree.'
        _children:
        - 7e27625ba6e04899a39ead413b67f1b9
    - rid: 1001
      type: {class: Selector, ns: CGD.BehaviorTrees, asm: CGD.Runtime}
