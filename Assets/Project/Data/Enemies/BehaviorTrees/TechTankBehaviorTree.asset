    RefIds:
    - rid: 1000
      type: {class: BtRoot, ns: CGD.BehaviorTrees, asm: CGD.Runtime}
      data:
        _guid: ee7696869a6d413ead9ebb2c4d141e61
        _position: {x: 0, y: 0}
        _comment: 'TECH siege (sentinel), stripped back to its basic attack for now: no abilities or grenades. A slow, heavily plated machine that holds a post just behind the other Tech (4 m behind the ally nearest the threat, next to cover, close enough that its Soak Aura takes 30% of every hit its allies within 8 m suffer onto its plating) and fires a three-step combo: a bullet burst, three mortar strikes, a missile. It weaves the combo into its footwork: it fires the bullet burst and the mortar strikes on the move, walking on toward the best spot behind its allies by cover while it casts and fires them, and only plants itself for the missile; while it decompresses after each step it keeps repositioning. Lost sight, it fights the Tech way (TechStance).'
        _children:
        - 223ff6ed9e754768b53109e721a0d4ab
