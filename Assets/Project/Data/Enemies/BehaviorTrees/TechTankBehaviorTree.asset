    RefIds:
    - rid: 1000
      type: {class: BtRoot, ns: CGD.BehaviorTrees, asm: CGD.Runtime}
      data:
        _guid: ee7696869a6d413ead9ebb2c4d141e61
        _position: {x: 0, y: 0}
        _comment: 'TECH tank (siege walker): a slow, heavy machine buried in armour and plating that leads its squad from the front. It holds the line just ahead of its allies and keeps the enemy pinned with suppressing fire (small rockets that burst on impact) instead of chasing kills, fires a Missile Salvo at what it can see (Signature), shells where the enemy was last seen with a Mortar Shell every 7 s, lobs its kit grenade at close quarters, Fortifies under fire (Boost) and bashes away anything that rushes it (Special). Its Soak Aura takes 35% of every hit on an ally within 8 m. Low damage, hard to kill. Kit: Signature (Missile Salvo), Boost (Fortify), Special (Weapon Bash), Grenade (Tech Grenade); the Mortar Shell is set on the tree.'
        _children:
        - 6500fc4156ae4ba292321f0ad728f697
    - rid: 1001
      type: {class: Selector, ns: CGD.BehaviorTrees, asm: CGD.Runtime}
