    RefIds:
    - rid: 1000
      type: {class: BtRoot, ns: CGD.BehaviorTrees, asm: CGD.Runtime}
      data:
        _guid: e4d69326bccd43c082ec4875c5e075b6
        _position: {x: 0, y: 0}
        _comment: 'A third party (scavenger, carrion beast, raider — any faction): in someone else''s fight it hangs back 12–18 m off, out of sight, watching. It commits only when its target is busy fighting someone else or worn below 35% health — a few seconds of all-out attack — then withdraws to a bush or cover and waits for the next chance.'
        _children:
        - 9e205644da0348d594a35d7689ae5aac
    - rid: 1001
      type: {class: Selector, ns: CGD.BehaviorTrees, asm: CGD.Runtime}
      data:
        _guid: 9e205644da0348d594a35d7689ae5aac
        _position: {x: 0, y: 150}
        _comment: 'Strike a distracted or weakened target; otherwise watch from hiding'
        _children:
        - 14f53a8669f84b8e80b5246ef4b7f783
        - f895975a87ec4acf8942245bdb60ed05
        - 115d73b3e5dc4188be04e293ac8851ed
