    RefIds:
    - rid: 1000
      type: {class: BtRoot, ns: CGD.BehaviorTrees, asm: CGD.Runtime}
      data:
        _guid: 66f2bf7fdcce49e099fda31f069b28ef
        _position: {x: 0, y: 0}
        _comment: 'A haunting (ghost, wraith, a hologram gone wrong — any faction''s apparition): it never fights under your gaze — look at it and it slips out of sight; look away and it drifts closer, and strikes the moment it is in reach and unwatched. Give its prefab a Horror Presence so it glitches while you stare.'
        _children:
        - 6a7f16ad9a53413cb437c2927283fd5b
