      type: {class: BtRoot, ns: CGD.BehaviorTrees, asm: CGD.Runtime}
      data:
        _guid: dbddd9fab59f4d17a8aeba0dd335a662
        _position: {x: 0, y: 0}
        _comment: 'A cloaker (infiltrator, stalker, shade — any faction): the moment it is seen with its escape ready (Kit › Escape, e.g. an Ambush cloak) it vanishes, slips round to its target''s side by the least-watched route, pounces when the target turns its back, and strikes in reach.'
