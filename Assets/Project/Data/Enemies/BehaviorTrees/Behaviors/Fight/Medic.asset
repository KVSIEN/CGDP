    RefIds:
    - rid: 1000
      type: {class: BtRoot, ns: CGD.BehaviorTrees, asm: CGD.Runtime}
      data:
        _guid: d067627442b9439e825d2f413ae7a452
        _position: {x: 0, y: 0}
        _comment: 'A combat medic (field medic bot, healer, mender — any faction): keeps out of reach, goes to whichever ally of its own side is worst off or being hit hardest and uses its Support on it (a heal, a shield top-up, a cleanse), coming in on the ally''s far side from the threat. With two or more kin fighting near it, it casts its Signature for the team (a Barrier Field: armour for everyone near). Otherwise it shoots from cover. Kill it first. Kit: Support and Signature.'
        _children:
        - 3cb9c82e282641abae36e23be1d4733f
    - rid: 1001
      type: {class: Selector, ns: CGD.BehaviorTrees, asm: CGD.Runtime}
      data:
        _guid: 3cb9c82e282641abae36e23be1d4733f
        _position: {x: 0, y: 150}
        _comment: 'Back off when pressed; mend whoever needs it most; shield the team; otherwise fight from cover'
