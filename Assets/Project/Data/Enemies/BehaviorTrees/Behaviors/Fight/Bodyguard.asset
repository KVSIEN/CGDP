    RefIds:
    - rid: 1000
      type: {class: BtRoot, ns: CGD.BehaviorTrees, asm: CGD.Runtime}
      data:
        _guid: cab4fa2524aa4e3cbb91dd9884fae29b
        _position: {x: 0, y: 0}
        _comment: 'A bodyguard (escort, royal guard, sentinel drone — any faction): keeps between the highest-tier ally near it (a boss, a broodmother, an engineer) and the threat, facing the threat and, if it fights at range, firing; strikes what gets into reach; falls back with its ward. Kill the guard first, or get round it. With nobody to guard it simply fights.'
        _children:
        - 08330eed6cbe4b5f9fc6a076a6463982
    - rid: 1001
      type: {class: Selector, ns: CGD.BehaviorTrees, asm: CGD.Runtime}
