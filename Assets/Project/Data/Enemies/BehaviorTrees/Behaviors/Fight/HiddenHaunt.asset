      type: {class: BtRoot, ns: CGD.BehaviorTrees, asm: CGD.Runtime}
      data:
        _guid: 5d4c489d195e5a4b1d867dd6e4c25314
        _position: {x: 275, y: 0}
        _comment: 'Void lying in wait in cover: stares at the target and makes noises beyond it to turn its head (Haunt From Cover). The moment the target looks away within reach it siphons it (Special slot), or lunges if the Siphon is not ready. Fails if given away or the target never looks away. Put it behind Is Hidden.'
