    - rid: 1000
      type: {class: BtRoot, ns: CGD.BehaviorTrees, asm: CGD.Runtime}
      data:
        _guid: bf31fb38c4174c7e913884675761e2db
        _position: {x: 0, y: 0}
        _comment: 'An unstoppable heavy (mech, brute, colossus — any faction): walks straight at its target at a steady pace, facing it and firing all the way; uses its boost (Kit › Boost, e.g. Fortify) when under fire, its signature (Kit › Signature, e.g. Ground Slam) on anything within 4 m, and strikes in reach. Never retreats. Give it heavy armour.'
        _children:
        - 87275a75e8b140d6867a635840edcd51
