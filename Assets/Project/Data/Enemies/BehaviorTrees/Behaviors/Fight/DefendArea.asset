    RefIds:
    - rid: 1000
      type: {class: BtRoot, ns: CGD.BehaviorTrees, asm: CGD.Runtime}
      data:
        _guid: be5636223fe54ccf8ddbba3665b5fb32
        _position: {x: 0, y: 0}
        _comment: 'A defender (garrison, warden, hive guard — any faction): holds the area round its post (12 m) — a room, a doorway, a terminal. It fights whatever comes into the area but never chases past its edge; it shoots at what approaches from inside the edge (if it fights at range); pulled out of the area it goes back to its spot; quiet, it guards. Place it where it should defend.'
        _children:
        - d6aaac5bb5ab4d22b06266d02715737c
