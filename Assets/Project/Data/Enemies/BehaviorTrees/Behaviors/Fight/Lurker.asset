    - rid: 1000
      type: {class: BtRoot, ns: CGD.BehaviorTrees, asm: CGD.Runtime}
      data:
        _guid: 0449efc177104b348ba195702f8cbdbf
        _position: {x: 0, y: 0}
        _comment: 'An ambush predator (trapdoor spider, swamp lurker, mine-layer — any faction): lies motionless in a bush near its target''s path and lets it come. Within 5 m and not being looked at, it erupts: a lunge and two strikes, then it goes to ground in the nearest bush again.'
        _children:
        - b0e67538640641518f2ac9be98b027b8
