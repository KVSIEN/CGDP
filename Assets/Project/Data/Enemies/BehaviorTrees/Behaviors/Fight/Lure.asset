    - rid: 1000
      type: {class: BtRoot, ns: CGD.BehaviorTrees, asm: CGD.Runtime}
      data:
        _guid: ec11c2ad949944cfaee31caea5fe70db
        _position: {x: 0, y: 0}
        _comment: 'A lure (anglerfish, mimic, decoy beacon — any faction): stays hidden in a bush and makes noises somewhere else — beside its target, or behind it — every few seconds, drawing it (and anyone else) to look the wrong way while its kin come in from the side. Strikes only what comes close. Give its Make Noise nodes a sound.'
        _children:
        - 194ff940a9924c51957fa0ae61eac717
