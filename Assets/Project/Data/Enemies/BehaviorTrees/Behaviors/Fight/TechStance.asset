    RefIds:
    - rid: 1000
      type: {class: BtRoot, ns: CGD.BehaviorTrees, asm: CGD.Runtime}
      data:
        _guid: 3f6a1c92d7e84b05a9c3e18b2d40f7a1
        _position: {x: 0, y: 0}
        _comment: 'The TECH way of holding a fight, as the TechBehaviorTree agent does it: too close (within 9 m) it falls back to cover at long range (or just backs off); otherwise it fires from long-range cover for 4-6 s, then moves to a fresh spot, or with no cover keeps its distance and shoots on the move. Lost sight, it works through where the target most likely went (Overwatch from a vantage), or stays in cover watching the angle it vanished at. Shared by the Tech tank and support for when their own role has nothing to do. Fails with nothing to do. Its basic attack is whatever Shoot Burst fires for that enemy.'
        _children:
        - 8c2e5b17a40d4f93b6d1e7a3c95f0b28
    - rid: 1001
      type: {class: Selector, ns: CGD.BehaviorTrees, asm: CGD.Runtime}
