    RefIds:
    - rid: 1000
      type: {class: BtRoot, ns: CGD.BehaviorTrees, asm: CGD.Runtime}
      data:
        _guid: 8cf824362c534e1cb9ac375b6e750f8b
        _position: {x: 0, y: 0}
        _comment: 'A disruptor / crowd controller (jammer drone, binder, null-caster — any faction): takes away your tools rather than your health. The moment it sees you it lays its Signature on you (Jamming Pulse: no abilities for 4 s; or a Null Field: no abilities and slowed while you stand in it) and moves to fresh cover; when you rush it, it pins you in place with its Special (a Tether: held for 2 s, mash to break free, then slowed); within 7 m it backs off. Otherwise it shoots from cover. Kit: Signature and Special.'
        _children:
        - 9c09ac1474b54cb68ac3d0841667dabe
    - rid: 1001
      type: {class: Selector, ns: CGD.BehaviorTrees, asm: CGD.Runtime}
      data:
        _guid: 9c09ac1474b54cb68ac3d0841667dabe
        _position: {x: 0, y: 150}
        _comment: 'Tether a rush; back off; jam on sight; shoot from cover'
