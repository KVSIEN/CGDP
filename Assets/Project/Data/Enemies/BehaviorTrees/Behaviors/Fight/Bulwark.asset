    - rid: 1000
      type: {class: BtRoot, ns: CGD.BehaviorTrees, asm: CGD.Runtime}
      data:
        _guid: 64b31246bc8f438b82cce5f40eee251f
        _position: {x: 0, y: 0}
        _comment: 'A shield-bearer (riot bot, carapace, tower shield — any faction): advances slowly, always facing its target, to mid range, then holds there facing it and firing, giving its squad cover; bashes anything in reach. Give its prefab a Frontal Shield (most damage from the front is stopped), so the answer is to flank it.'
        _children:
        - f7ac4e96d5854807b7709f186ca97de3
