      type: {class: ForceResult, ns: CGD.BehaviorTrees, asm: CGD.Runtime}
      data:
        _guid: 325642f2b8274af8bb91631e3d04cbf7
        _position: {x: -330, y: 300}
        _comment: 'Stalk and size it up: circle it from bush to bush at a wary distance for a few seconds. An opening (its back turned, reloading) ends the stalk at once'
        _children:
        - 455a1ed8ee1843de86cb34751ef5908c
