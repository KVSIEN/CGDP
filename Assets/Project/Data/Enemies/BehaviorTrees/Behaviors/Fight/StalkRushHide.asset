    - rid: 1000
      type: {class: BtRoot, ns: CGD.BehaviorTrees, asm: CGD.Runtime}
      data:
        _guid: 7971759471a94f2293a8098787391139
        _position: {x: 0, y: 0}
        _comment: 'A predator''s hunt in a loop: stalk the target from bush to bush, watching it (cut short the moment it turns its back or reloads), rush in for a committed strike, break off to a bush away from it and lie low, then stalk again from wherever the target last saw it least.'
        _children:
        - b5138bdf35b941928545489fabff7dd2
    - rid: 1001
      type: {class: Sequence, ns: CGD.BehaviorTrees, asm: CGD.Runtime}
      data:
        _guid: b5138bdf35b941928545489fabff7dd2
        _position: {x: 0, y: 150}
        _comment: 'Stalk, rush, disengage, hide; then round again'
        _children:
        - 325642f2b8274af8bb91631e3d04cbf7
        - 530292ba5f17438696e5247e43297058
        - f0254c0673524c93bfc9796e1004b2f7
        - 19bd31b2c0534cbc8d422be664d78624
        _abort: 0
