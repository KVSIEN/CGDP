    - rid: 1000
      type: {class: BtRoot, ns: CGD.BehaviorTrees, asm: CGD.Runtime}
      data:
        _guid: 5b8b85e7cc774efe96f64ae145897780
        _position: {x: 0, y: 0}
        _comment: 'A disruptor (hacker, EMP unit, mind-flayer — any faction): keeps its distance; the moment it has its target in view with its signature ready (Kit › Signature, e.g. EMP Pulse: a short stun and a slow) it pulses it, then moves to fresh cover; between pulses it shoots from cover. Falls back from anything within 10 m.'
        _children:
        - 7b2350b8be1047e8a14d7a0c7d1a7672
