    - rid: 1000
      type: {class: BtRoot, ns: CGD.BehaviorTrees, asm: CGD.Runtime}
      data:
        _guid: 01ea770475a24da79c9f932c8d0ea0b0
        _position: {x: 0, y: 0}
        _comment: 'A regenerator (troll, moss-beast, self-repairing frame — any faction): brawls until below 45% health, then crashes into the nearest bush (or behind cover), regrows with its boost (EnemyData › Kit › Boost: a heal) and comes back. Keep it out of cover or it never dies.'
        _children:
        - 0195eb9480f8421ab94328ac1193905b
