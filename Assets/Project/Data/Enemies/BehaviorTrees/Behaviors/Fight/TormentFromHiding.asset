      type: {class: BtRoot, ns: CGD.BehaviorTrees, asm: CGD.Runtime}
      data:
        _guid: f91666e0f4f448e1af3d52ac29eb52d1
        _position: {x: 0, y: 0}
        _comment: 'An unseen tormentor (poltergeist, saboteur, sniper''s spotter — any faction): it keeps behind full cover and hurls its kit grenade at you every few seconds, and now and then shows itself for a moment without attacking — just to be seen — then is gone again. Needs EnemyData › Kit › Grenade.'
