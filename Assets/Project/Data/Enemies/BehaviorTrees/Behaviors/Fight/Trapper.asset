    RefIds:
    - rid: 1000
      type: {class: BtRoot, ns: CGD.BehaviorTrees, asm: CGD.Runtime}
      data:
        _guid: 37a879c984f840689ec7fb4f91174f0e
        _position: {x: 0, y: 0}
        _comment: 'A trapper (mine-layer bot, snare-setter — any faction): whenever its Signature (a Trap ability: Proximity Mine, Jaw Trap) is ready it lays a trap a few metres out between itself and its target, never on top of another of its own, so a field builds up in front of it; backs off when the target comes within 6 m, so following means crossing that field; shoots from cover in between; and where it loses the target it leaves a trap on the spot and watches. Its traps are live a second after landing, blink, and are shot apart. Kit: Signature (a Trap ability).'
        _children:
        - 5f7db8e7d24943639261e960e41dadbb
    - rid: 1001
      type: {class: Selector, ns: CGD.BehaviorTrees, asm: CGD.Runtime}
      data:
        _guid: 5f7db8e7d24943639261e960e41dadbb
        _position: {x: 0, y: 150}
        _comment: 'Back off when pressed; lay traps in the way; shoot from cover; trap where it lost the target'
        _children:
        - 7b2edc62d7294eddb6d7502091a7811e
